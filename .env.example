# Copy to .env.local (never committed) to connect the playground and `npm run eval` to a model.
# Any OpenAI-compatible server works.

# Base URL, up to /v1. Default: LM Studio on this machine.
#   LM Studio  http://localhost:1234/v1
#   Ollama     http://localhost:11434/v1
#   DeepSeek   https://api.deepseek.com/v1
#   OpenRouter https://openrouter.ai/api/v1
SAYSHAPE_MODEL_URL=http://localhost:1234/v1

# The model to use. Leave empty to pick from the server's list.
SAYSHAPE_MODEL=

# Only for servers that need a key. Stays on the dev server; the browser never sees it.
SAYSHAPE_API_KEY=

# Added to every request. For Qwen3, /no_think skips thinking so the first line appears sooner.
SAYSHAPE_USER_SUFFIX=

# Prompt caching for npm run eval and npm run compare: the guide is the same on every request, so a
# cache makes it much cheaper after the first. 1 caches for about 5 minutes, 1h for an hour. Anthropic
# models need this (directly or through OpenRouter); OpenAI caches long prompts without it.
SAYSHAPE_PROMPT_CACHE=
