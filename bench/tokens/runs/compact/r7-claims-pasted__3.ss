state monthly=[{month: "Jan", opened: 1, closed: 0, incurred: 42529}, {month: "Feb", opened: 2, closed: 0, incurred: 70865}, {month: "Mar", opened: 1, closed: 1, incurred: 43229}, {month: "Apr", opened: 3, closed: 0, incurred: 119528}, {month: "May", opened: 5, closed: 0, incurred: 129733}, {month: "Jun", opened: 7, closed: 2, incurred: 227521}, {month: "Jul", opened: 2, closed: 0, incurred: 48101}, {month: "Aug", opened: 5, closed: 1, incurred: 153216}, {month: "Sep", opened: 2, closed: 0, incurred: 75281}, {month: "Oct", opened: 3, closed: 2, incurred: 71282}, {month: "Nov", opened: 3, closed: 2, incurred: 91226}, {month: "Dec", opened: 6, closed: 3, incurred: 138394}]
state byLine=[{line: "Auto", count: 7, incurred: 239557}, {line: "Property", count: 4, incurred: 107639}, {line: "Liability", count: 11, incurred: 299790}, {line: "Workers comp", count: 5, incurred: 146634}, {line: "Marine", count: 3, incurred: 106396}, {line: "Cyber", count: 10, incurred: 310889}]
derive shown={status == 'All' ? claims : filter(claims, 'status', status)}

text "Claims review 2025" style=title
grid min=140 gap=12
  stat label="Total claims" value={len(claims)}
  stat label="Total incurred" value={compact(sum(claims, 'incurred'), 'USD')}
  stat label="Open or in review" value={count(claims, 'status', 'Open') + count(claims, 'status', 'In review')}
  stat label="Avg days to resolve" value={round(avg(claims, 'days'))}
grid min=300 gap=12
  card pad=18 gap=10
    chart "Incurred by month" kind=bar items=monthly x=month y=incurred format=money
  card pad=18 gap=10
    chart "Claims opened and closed by month" kind=line items=monthly x=month y=opened,closed
  card pad=18 gap=10
    chart "Incurred by line" kind=donut items=byLine x=line y=incurred format=money
card pad=18 gap=10
  text "All claims" style=title
  segmented bind=status label="Filter by status" options="All,Open,In review,Closed,Denied"
  text "{len(shown)} of {len(claims)} claims shown" tone=muted
  table "Claims" items=shown key=id
    table-column "ID" field=id
    table-column "Opened" field=opened
    table-column "Line" field=line
    table-column "Site" field=site
    table-column "Status" field=status
    table-column "Incurred" field=incurred format=money align=right
    table-column "Days" field=days format=number align=right
