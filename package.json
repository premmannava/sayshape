{
  "name": "sayshape",
  "version": "0.1.1",
  "description": "A canvas UI engine and a UI language designed for AI models to write.",
  "type": "module",
  "license": "MIT",
  "author": "premmannava",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/premmannava/sayshape.git"
  },
  "homepage": "https://premmannava.github.io/sayshape/",
  "bugs": {
    "url": "https://github.com/premmannava/sayshape/issues"
  },
  "keywords": [
    "generative-ui",
    "ui-language",
    "canvas",
    "ai",
    "llm",
    "mcp",
    "sayshape"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/sayshape.js",
  "module": "./dist/sayshape.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/sayshape.global.js",
  "jsdelivr": "./dist/sayshape.global.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sayshape.js"
    },
    "./map": {
      "types": "./dist/types/components/map/index.d.ts",
      "import": "./dist/map.js"
    },
    "./scene": {
      "types": "./dist/types/components/scene/index.d.ts",
      "import": "./dist/scene.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/testing.js"
    },
    "./model": {
      "types": "./dist/types/model/index.d.ts",
      "import": "./dist/model.js"
    },
    "./global": "./dist/sayshape.global.js",
    "./map/global": "./dist/sayshape-map.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-browser.mjs && tsc -p tsconfig.build.json && node scripts/fix-dts-imports.mjs",
    "build:playground": "vite build --config vite.playground.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:world": "node scripts/build-world.mjs",
    "docs:components": "vite-node scripts/gen-component-docs.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:docker": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.56.1-noble /bin/bash -c \"npm ci && npx playwright test $VISUAL_ARGS\"",
    "bench": "vitest bench --run",
    "docs:check": "vite-node scripts/gen-component-docs.ts --check",
    "new:component": "vite-node scripts/new-component.ts --",
    "eval": "vite-node scripts/eval.ts --",
    "compare": "vite-node scripts/compare.ts --",
    "sessions": "vite-node scripts/sessions.ts --",
    "eval:answers": "vite-node scripts/eval-answers.ts --",
    "pick-eval": "vite-node scripts/pick-eval.ts --",
    "guide:size": "vite-node scripts/guide-size.ts",
    "site:docs": "vite-node scripts/gen-site-docs.ts",
    "site:dev": "npm run site:docs && npm --prefix site run dev",
    "site:build": "npm run site:docs && npm --prefix site run build",
    "site:preview": "npm --prefix site run preview",
    "site:check": "node scripts/check-site.mjs",
    "scene-eval": "vite-node scripts/scene-eval.ts --",
    "bench:scene-browser": "node bench/browser/run.mjs",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@a2ui/lit": "0.15.0",
    "@a2ui/markdown-it": "0.2.2",
    "@a2ui/web_core": "0.15.0",
    "@axe-core/playwright": "4.14.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.56.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.9.0",
    "d3-geo": "^3.1.1",
    "fast-check": "4.3.0",
    "jsdom": "25.0.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "5.6.3",
    "us-atlas": "^3.0.1",
    "vite": "5.4.10",
    "vite-node": "^2.1.4",
    "vitest": "2.1.4",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "@a2ui/markdown-it": {
      "@a2ui/web_core": "$@a2ui/web_core"
    }
  }
}
