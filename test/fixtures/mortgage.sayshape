# Mortgage calculator: the yearly schedule is worked out by three derive lines, for any term.
state loan=300000 rate=6 years=30
derive i={rate / 1200}
derive pay={loan * i / (1 - pow(1 + i, -years * 12))}
derive schedule={map(range(1, years + 1), 'y', {year: y, balance: max(0, round(loan * pow(1 + i, y * 12) - pay * (pow(1 + i, y * 12) - 1) / i)), interest: round(pay * 12 * y - loan + loan * pow(1 + i, y * 12) - pay * (pow(1 + i, y * 12) - 1) / i)})}
text "Mortgage" style=title
slider "Loan: {money(loan)}" bind=loan min=50000 max=1000000 step=10000
slider "Rate: {rate}%" bind=rate min=1 max=12 step=0.25
stepper "Years" bind=years min=1 max=40
stat label="Monthly payment" value={money(pay)}
chart "Balance and interest paid" kind=line items=schedule x=year y=balance,interest labels="Balance,Interest paid" format=money
table "Schedule" items=schedule
  table-column field=year
  table-column field=balance format=money
  table-column field=interest format=money
